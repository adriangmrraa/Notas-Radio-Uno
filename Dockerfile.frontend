# ============================================
# STAGE 1: Build React con Vite
# ============================================
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
# postinstall resiliente (no-ops sin remotion/, que acá no se copia)
COPY scripts/postinstall-remotion.mjs scripts/
RUN npm ci

COPY src/client/ src/client/
COPY src/shared/ src/shared/
COPY public/ public/
COPY vite.config.ts ./
COPY tsconfig.json ./
COPY index.html ./

# Variables de build (se inyectan como build args en EasyPanel)
ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build:client

# ============================================
# STAGE 2: Nginx
# ============================================
FROM nginx:1.27-alpine

COPY --from=builder /app/dist/client /usr/share/nginx/html
# Template con envsubst: el entrypoint oficial de nginx:alpine procesa
# /etc/nginx/templates/*.conf.template → /etc/nginx/conf.d/*.conf
# sustituyendo ${API_UPSTREAM}.
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY public/ /usr/share/nginx/html/

# Upstream de la API. Default: mismo contenedor (all-in-one).
# En EasyPanel/Compose apuntar al servicio API: -e API_UPSTREAM=http://api:3001
ENV API_UPSTREAM=http://127.0.0.1:3001

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -q --spider http://localhost:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
