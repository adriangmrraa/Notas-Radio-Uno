# ================================================
# PERIODISTAPP - PRODUCTION ENVIRONMENT VARIABLES
# ================================================
#
# Copia este archivo como .env en tu VPS y rellena los valores.
# Para producción, NODE_ENV debe ser "production".
#
# ================================================
# 1. DATABASE (PostgreSQL) - REQUERIDO
# ================================================
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
# IMPORTANTE: el driver DB es @neondatabase/serverless (WebSocket al proxy
# de Neon). Funciona contra Neon serverless y contra un Postgres con
# endpoint compatible; un Postgres local pelado requiere el proxy de Neon.
DATABASE_URL=postgresql://periodist:TU_CONTRASENA_SEGURA@localhost:5432/periodistapp

# ================================================
# 2. REDIS (Opcional pero recomendado para cache/sessions)
# ================================================
# Si instalás Redis en el mismo VPS, descomenta y configura:
# REDIS_URL=redis://:TU_CONTRASENA_REDIS@localhost:6379

# ================================================
# 3. AUTHENTICATION & SECURITY - REQUERIDOS
# ================================================
# Generar con: openssl rand -hex 32
# OBLIGATORIO en producción: sin JWT_SECRET el servidor no arranca
# (desde Épica J — antes caía en un fallback público conocido).
JWT_SECRET=GENERA_UN_SECRETO_SEGURO_DE_32_BYTES_EN_HEX

# Clave para cifrar datos sensibles en DB (mismo comando)
ENCRYPTION_KEY=GENERA_OTRO_SECRETO_SEGURO_DE_32_BYTES_EN_HEX

# URL pública del frontend (sin / al final)
FRONTEND_URL=https://app.tudominio.com
# Origenes extra permitidos por CORS (separados por coma)
ALLOWED_ORIGINS=https://app.periodistapp.com,https://periodistapp.com

# ================================================
# 4. SERVER CONFIGURATION
# ================================================
NODE_ENV=production
PORT=3001

# Rol del proceso (PJ-04). Qué inicializa cada valor:
#   all    → API + WS + schedulers + workers (default, un solo proceso)
#   api    → solo API + WS (sin schedulers ni workers)
#   worker → solo schedulers + workers (sin API/WS)
# LIMITACIÓN conocida con 'worker': los eventos socket que emiten los
# workers no llegan a los clientes del proceso api (no hay adapter/socket
# compartido todavía). Usar 'worker' solo para aislar cómputo.
# PROCESS_ROLE=all

# ================================================
# 5. AI PROVIDERS - mínimo uno requerido
# ================================================
# DeepSeek (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-tu_key_deepseek

# Google Gemini (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=AIzaSyTU_KEY_GEMINI

# xAI (Grok) - opcional
XAI_API_KEY=xai-tu_key_xai

# ================================================
# 6. TWITTER / X API - para publicar automáticamente
# ================================================
# Crear app en https://developer.twitter.com/
TWITTER_APP_KEY=TU_CONSUMER_KEY
TWITTER_APP_SECRET=TU_CONSUMER_SECRET
TWITTER_ACCESS_TOKEN=TU_ACCESS_TOKEN
TWITTER_ACCESS_SECRET=TU_ACCESS_SECRET
TWITTER_CLIENT_ID=TU_CLIENT_ID  # Para OAuth2

# ================================================
# 7. GOOGLE APIs - para Google Drive y búsqueda
# ================================================
# Service Account para Google Drive (crear en Google Cloud Console)
GOOGLE_CLIENT_EMAIL=tu-service-account@proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nTU_LLAVE_PRIVADA\n-----END PRIVATE KEY-----
GOOGLE_FOLDER_ID=ID_DE_CARPETA_DRIVE  # Donde se guardarán los archivos

# Google Custom Search (opcional - para búsqueda de noticias)
GOOGLE_SEARCH_API_KEY=TU_KEY_GOOGLE_SEARCH
GOOGLE_SEARCH_CX=ID_DEL_MOTOR_DE_BUSQUEDA

# ================================================
# 8. META (Facebook + Instagram) - para publicar
# ================================================
# Crear app en https://developers.facebook.com/
META_APP_ID=TU_APP_ID
META_APP_SECRET=TU_APP_SECRET
META_CONFIG_ID=TU_CONFIG_ID  # ID de configuración de publicación

# ================================================
# 9. STRIPE - para pagos (si usás la funcionalidad de billing)
# ================================================
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_TU_KEY_SECRETA
STRIPE_WEBHOOK_SECRET=whsec_TU_WEBHOOK_SECRET

# ================================================
# 10. MERCADOPAGO - para pagos en Argentina (opcional)
# ================================================
MP_ACCESS_TOKEN=TU_ACCESS_TOKEN_MERCADOPAGO

# ================================================
# 11. EMAIL (SMTP) - para notificaciones y recuperación de contraseña
# ================================================
# Configuración para Gmail o tu propio servidor SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true  # true para SSL, false para STARTTLS
SMTP_USER=noreply@tudominio.com
SMTP_PASS=TU_CONTRASENA_DE_APLICACION_GMAIL
SMTP_FROM="PeriodistApp <noreply@tudominio.com>"

# ================================================
# 12. WEBHOOKS - para integraciones externas
# ================================================
# URLs que recibirán notificaciones cuando se complete un pipeline
WEBHOOK_URL_PIPELINE=https://tudominio.com/webhook/pipeline
WEBHOOK_URL_NUEVO_BOTON=https://tudominio.com/webhook/nuevo-boton
WEBHOOK_URL_VIEJO_BOTON=https://tudominio.com/webhook/viejo-boton
WEBHOOK_URL_TERCER_BOTON=https://tudominio.com/webhook/tercer-boton

# ================================================
# 13. PLATFORM & BRANDING
# ================================================
# Nombre que aparecerá en placas, artículos y prompts de IA
PLATFORM_NAME=Radio Uno Formosa

# ================================================
# 14. TOOLS & PATHS
# ================================================
# Directorio donde se instalan herramientas como ffmpeg, whisper, yt-dlp
# En producción, generalmente están en /usr/bin o /usr/local/bin
TOOLS_DIR=/usr/local/bin

# ================================================
# 15. APP SPECIFIC
# ================================================
# Variables internas del sistema (no modificar a menos que sepas)
# NODE_OPTIONS=--max-old-space-size=4096  # Para VPS con 4GB+ RAM

# ================================================
# 16. TRANSCRIPCION CON DIARIZACION
# ================================================
# AssemblyAI para diarizacion de hablantes (opcional — mejora atribucion de citas)
# Registro gratuito en https://www.assemblyai.com/
# Sin esta key, el sistema usa Whisper (sin distincion de hablantes)
ASSEMBLYAI_API_KEY=

# ================================================
# 17. INGESTA DE VIDEO (PD-02)
# ================================================
# Proxies para la resolucion de streams (decision B-1): YouTube bloquea IPs
# de datacenter, asi que cada intento de resolucion de yt-dlp rota al
# siguiente proxy de la lista (CSV). Si todos fallan se reintenta directo.
# Vacio = conexion directa.
# INGEST_PROXY_URLS=http://user:pass@proxy1:8080,http://proxy2:8080
INGEST_PROXY_URLS=

# ================================================
# 18. RETENCION DEL CRUDO (PD-06)
# ================================================
# Purga diaria de segmentos MP4 crudos vencidos segun raw_retention_days del plan.
# false/0 = desactivar el job (no borra nada). Default: activada.
# RETENTION_PURGE_ENABLED=true
# Intervalo en MINUTOS entre purgas (default 1440 = 1 vez por dia). Minimo 1.
# El primer tick del scheduler hace un catch-up, despues respeta el intervalo.
# RETENTION_PURGE_INTERVAL_MINUTES=1440

# ================================================
# 19. CONEXION DE CUENTAS SOCIALES — ZERNIO (PG-04)
# ================================================
# API key DE LA PLATAFORMA (una sola): los tenants se aíslan por perfil
# Zernio (externalId = tenant_id), nunca tienen key propia.
# NUNCA se commitea el valor real. Sin esta key, /api/social-connections
# responde 503 zernio_not_configured.
# ZERNIO_API_KEY=zrn_live_...
ZERNIO_API_KEY=
# Base URL publica de ESTA API para el redirect_url del OAuth (callback).
# Default: FRONTEND_URL o http://localhost:3001.
# API_PUBLIC_URL=https://api.tudominio.com
API_PUBLIC_URL=
# Secreto para firmar el state del callback (default: JWT_SECRET).
# ZERNIO_STATE_SECRET=
ZERNIO_STATE_SECRET=
# URL publica del logo para la pantalla welcome de Zernio (opcional —
# el logo del tenant se sirve con auth y Zernio no podria traerlo).
# ZERNIO_BRAND_LOGO_URL=https://...
ZERNIO_BRAND_LOGO_URL=

# ================================================
# 20. COLA DE PUBLICACION ZERNIO (PG-05)
# ================================================
# Worker que claimea publish_jobs y publica via Zernio (POST /v1/posts con
# Idempotency-Key). Requiere ZERNIO_API_KEY (seccion 19).
# 0/false = desactivar el worker (los jobs quedan 'queued'). Default: activado.
# PUBLISH_WORKER_ENABLED=true
# Intervalo de claim en milisegundos (default 10000 = 10 s).
# PUBLISH_WORKER_POLL_MS=10000

# ================================================
# 21. BACKUP DE ASSETS DERIVADOS (PI-05)
# ================================================
# Espejo incremental de los archivos generados (renders de clips, flyers,
# imagenes) bajo <repo>/output hacia un arbol de backup separado.
# Raiz del arbol de backup. Default: <repo>/data/backup.
# BACKUP_ROOT=/var/backups/periodistapp/assets
# Raiz del arbol fuente (los assets derivados). Default: <repo>/output.
# ASSET_SOURCE_ROOT=/srv/app/output
#
# Driver del DESTINO del espejo: fs (default) | s3 (PJ-05).
# El destino es write-only (stat/write/delete) — el driver S3 usa las
# vars S3_* de abajo. El crudo (raw segments) SIEMPRE queda en fs local:
# ffmpeg escribe via publicPath — migrarlo a S3 requiere staging local.
# BACKUP_DRIVER=fs
#
# Credenciales S3-compatibles (AWS, R2, MinIO) — requeridas si BACKUP_DRIVER=s3:
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=            # vacio = AWS; R2/MinIO van aca (path-style)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=              # prefijo opcional de keys dentro del bucket
# Sync periodico desde el scheduler de transmisiones.
# false/0 = desactivar (no copia nada). Default: activado.
# BACKUP_SYNC_ENABLED=true
# Intervalo en MINUTOS entre syncs (default 1440 = 1 vez por dia). Minimo 1.
# El primer tick del scheduler hace un catch-up, despues respeta el intervalo.
# BACKUP_SYNC_INTERVAL_MINUTES=1440

# ================================================
# 22. CONCURRENCIA DE WORKERS (PJ-04)
# ================================================
# Tope de transmisiones procesándose en paralelo por el scheduler.
# Default 5.
# MAX_CONCURRENT_TRANSMISSIONS=5
# Topes de jobs en vuelo por worker (el tick no despacha si inFlight >= cap):
#   clipRenderWorker  → RENDER_MAX_IN_FLIGHT   (default 2; ffmpeg pesa CPU)
#   publishWorker     → PUBLISH_MAX_IN_FLIGHT  (default 3)
#   jobQueueWorker    → JOB_QUEUE_MAX_IN_FLIGHT (default 3)
# RENDER_MAX_IN_FLIGHT=2
# PUBLISH_MAX_IN_FLIGHT=3
# JOB_QUEUE_MAX_IN_FLIGHT=3

# ================================================
# 23. NGINX FRONTEND (Dockerfile.frontend)
# ================================================
# Upstream de la API para el contenedor nginx (envsubst del template
# nginx/default.conf.template). Default en la imagen: http://127.0.0.1:3001
# En EasyPanel/Compose apuntar al nombre del servicio: http://api:3001
# API_UPSTREAM=http://api:3001
